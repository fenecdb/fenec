# The standby of a region's router: the same process, following the
# primary's directory (--replica-of FENEC_PRIMARY), on another machine --
# in another zone. It forwards every request as the primary does and
# refuses changes (409) until it is promoted. It carries the primary's
# flags, so that once promoted it leases the nodes and fails them over as
# the primary did.
#
# Promoting it is an operator's call, never the routers' (deploy/RUNBOOK.md):
#   curl -X POST -H "Authorization: Bearer $FENEC_SHARD_REPLICATION_TOKEN" \
#        http://<this machine>:8090/_replication/promote
#   systemctl enable fenec-router && systemctl disable fenec-router-standby
#   systemctl start fenec-router
# The directory is the same file under both units, which conflict: the last
# start stops this one and opens the promoted file as the primary's. Do it
# at once -- this unit started again, by a crash or a reboot, would have the
# promoted file follow FENEC_PRIMARY again.
#
#   install -m 0644 fenec-router-standby.service /etc/systemd/system/
#   install -m 0600 ../env/router.env /etc/fenecdb/router.env   # then edit it
#   systemctl enable --now fenec-router-standby

[Unit]
Description=fenecdb region router (fenec-shard --region) standby
Documentation=https://fenecdb.com/docs/sharding-reference#deploying file:/usr/local/share/doc/fenecdb/RUNBOOK.md
After=network-online.target
Wants=network-online.target
# One process on the directory file at a time: two corrupt it.
Conflicts=fenec-router.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=fenec-router
Group=fenec-router
EnvironmentFile=/etc/fenecdb/router.env
# --region keeps the region's nodes and tenants in this router's directory,
# so it leases them and fails them over cut off from every other region;
# --global is where every other tenant lives (the global router, then its
# standby). --replicas gives each tenant a replica on a node of another
# zone of the region; --auto-failover leases the nodes for FENEC_LEASE
# seconds and fails over a node that lets its lease lapse.
ExecStart=/usr/local/bin/fenec-shard \
    --listen ${FENEC_LISTEN} \
    --directory /var/lib/fenecdb/router/directory.fenec \
    --region ${FENEC_REGION} \
    --global ${FENEC_GLOBAL} \
    --replicas \
    --auto-failover ${FENEC_LEASE} \
    --replica-of ${FENEC_PRIMARY} \
    --max-connections 1000 \
    --upstream-timeout ${FENEC_UPSTREAM_TIMEOUT} \
    --audit /var/log/fenecdb/router/audit.log \
    $FENEC_ROUTER_FLAGS
Restart=on-failure
RestartSec=2s

# The router writes and syncs each change of its directory before it acts
# on it, so SIGTERM's default action loses nothing: it holds no write. What
# it ends are the requests it was forwarding, which a client sends again.
KillSignal=SIGTERM
TimeoutStopSec=10s

# Descriptors: a client's connection each (--max-connections 1000) and a
# pooled one to a node for each in flight, the directory's replication and
# its standbys' streams -- 2 x 1000, with room. Raise with them.
LimitNOFILE=8192
# Threads: a connection each, under systemd's DefaultTasksMax unless set.
TasksMax=4096
# A core dump would hold every node's admin token.
LimitCORE=0

StateDirectory=fenecdb/router
StateDirectoryMode=0700
LogsDirectory=fenecdb/router
ReadWritePaths=/var/lib/fenecdb/router
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
