# /etc/fenecdb/archive.env -- every archiver on this machine
# (fenec-archive@<node>.service) and its bucket sync
# (fenec-archive-sync@<node>.service). Mode 0600, owned by root.

# The nodes' replication token (node.env's FENEC_REPLICATION_TOKEN): an
# archive is the replication stream written to files.
FENEC_REPLICATION_TOKEN=change-me-replication-token

# The bucket, as rclone names it in /etc/fenecdb/rclone.conf: a remote and a
# path. Each node's archive goes under it by the node's name.
FENEC_ARCHIVE_REMOTE=r2:fenecdb-archive/eu
