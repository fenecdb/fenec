# /etc/fenecdb/archive-sync.env -- every bucket sync on this machine
# (fenec-archive-sync@<node>.service). Holds no secret: the remote's keys are
# /etc/fenecdb/rclone.conf, handed to the run alone as a credential, and the
# archiver's replication token is not here, so rclone never sees it.

# The bucket, as rclone names it in /etc/fenecdb/rclone.conf: a remote and a
# path. Each node's archive goes under it by the node's name.
FENEC_ARCHIVE_REMOTE=r2:fenecdb-archive/eu
