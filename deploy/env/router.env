# /etc/fenecdb/router.env -- a region's router (fenec-router.service), and
# on another machine of the region its standby (fenec-router-standby.service):
# the same file but for FENEC_LISTEN, and FENEC_PRIMARY, which the standby
# alone reads. Mode 0600, owned by root (node.env says why). Every value is
# an example: make each token with `openssl rand -hex 32`.

# The private network's address: the other regions' routers relay to it,
# its standby follows it, the global router asks it, and cloudflared on this
# machine hands it the entry's requests.
FENEC_LISTEN=10.1.0.21:8090
# The region this router keeps: its nodes, its tenants, their leases.
FENEC_REGION=eu
# The global router, then its standby: where every other tenant lives.
FENEC_GLOBAL=http://10.1.0.31:8090,http://10.2.0.31:8090
# The nodes' lease, in seconds: a node lost is failed over a lease and a
# tenth after its last renewal (5.5 to 7.2 s at 5), and a node that cannot
# reach the router stops writing as its lease lapses. Shorter fails over
# sooner and asks more of the network between router and nodes.
FENEC_LEASE=5
# The standby's: the region's router it follows.
FENEC_PRIMARY=http://10.1.0.21:8090

# /_shard/ and /_metrics, and the HMAC the routers mark a relayed client
# with: one for every router of the deployment, the global ones too.
FENEC_SHARD_TOKEN=change-me-routers-token
# The directories' replication: a standby following its router, a region's
# routers following the global directory. One for every router.
FENEC_SHARD_REPLICATION_TOKEN=change-me-directory-replication-token
# The global entry's ENTRY_TOKEN (integrations/cloudflare/entry): the
# client's address the entry names, believed. Never one of the tokens above
# nor a node's admin token -- the router refuses to start on one.
FENEC_SHARD_ENTRY_TOKEN=change-me-entry-token

# Anything more, split at spaces: CORS for the pages the entry serves,
# tracing.
FENEC_ROUTER_FLAGS=--http-cors https://app.example.com
