# /etc/fenecdb/global.env -- the global router (fenec-global.service), and
# in another region its standby (fenec-global-standby.service): the same
# file but for FENEC_LISTEN, and FENEC_PRIMARY, which the standby alone
# reads. Mode 0600, owned by root (node.env says why). Every value is an
# example: make each token with `openssl rand -hex 32`.

# The private network's address: the regions' routers follow its directory
# and relay to it the changes every region must agree on.
FENEC_LISTEN=10.1.0.31:8090
# The standby's: the global router it follows.
FENEC_PRIMARY=http://10.1.0.31:8090

# The same three as every region's router (router.env).
FENEC_SHARD_TOKEN=change-me-routers-token
FENEC_SHARD_REPLICATION_TOKEN=change-me-directory-replication-token
FENEC_SHARD_ENTRY_TOKEN=change-me-entry-token

# Anything more, split at spaces: the region a tenant made naming none is
# placed in, CORS, tracing.
FENEC_GLOBAL_FLAGS=--default-region eu
