# /etc/fenecdb/node.env -- a tenant node (fenec-node.service).
# Mode 0600, owned by root: systemd reads it as root before the process
# starts, and the process alone gets the values, in its environment, which
# no other user reads (/proc/<pid>/environ is the owner's). Every value here
# is an example: make each token with `openssl rand -hex 32`.

# The node's own directory of tenant files.
FENEC_DIR=/var/lib/fenecdb/node
# Where the node listens -- the tenants' data, /_admin/, the replication
# streams and /_metrics -- on the private network the routers, the other
# nodes and the scraper reach it over, never a public address: fenec-server
# speaks no TLS (deploy/RUNBOOK.md, "The network"). /_metrics asks for this
# node's FENEC_HTTP_TOKEN or FENEC_ADMIN_TOKEN.
FENEC_LISTEN=10.1.0.11:8081

# The data token the tenants' clients send (or the policy's JWTs, below).
FENEC_HTTP_TOKEN=change-me-data-token
# /_admin/: this node's alone, held by the region's router in its directory
# (PUT /_shard/nodes/<n> {"token": ...}). One a node, none shared.
FENEC_ADMIN_TOKEN=change-me-admin-token-of-this-node
# Every node's tenants' replication streams: one for the cluster, which each
# node presents to the primary it follows and its archiver presents to it.
FENEC_REPLICATION_TOKEN=change-me-replication-token

# Anything more, split at spaces: quotas, JWTs, CORS, tracing. A token of a
# collector goes in OTEL_EXPORTER_OTLP_HEADERS below, not in a flag here.
FENEC_NODE_FLAGS=--tenant-max-bytes 1G --tenant-max-rows 1000000 --tenant-max-requests 32
# JWTs from an identity provider: its keys, the policy, and whom a token
# must be issued for. The provider's keys sign every app's tokens (and
# Firebase's every project's), so name the issuer and the audience
# (https://fenecdb.com/docs/http-access#whom-a-token-is-for):
# FENEC_NODE_FLAGS=... --jwt-keys /etc/fenecdb/jwks.json --policy /etc/fenecdb/policy.txt --jwt-issuer https://acme.us.auth0.com/ --jwt-audience https://api.example.com
# FENEC_NODE_FLAGS=... --otlp-endpoint http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=dd-api-key=change-me
