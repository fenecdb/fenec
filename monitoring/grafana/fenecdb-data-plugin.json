{
  "title": "fenecdb data (plugin)",
  "uid": "fenecdb-data-plugin",
  "tags": [
    "fenecdb"
  ],
  "description": "fenec-server's own rows through fenecdb-datasource: each panel is FenecQL, Grafana's range, interval and variables bound as parameters by the plugin's backend, the columns in the select list's order.",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-7d/d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "sym",
        "label": "Symbol",
        "datasource": {
          "type": "fenecdb-datasource",
          "uid": "fenecdb"
        },
        "query": {
          "refId": "variable",
          "queryText": "get ticks select sym, count(*) as trades group sym order sym"
        },
        "definition": "get ticks select sym, count(*) as trades group sym order sym",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "type": "query",
        "name": "syms",
        "label": "Symbols",
        "datasource": {
          "type": "fenecdb-datasource",
          "uid": "fenecdb"
        },
        "query": {
          "refId": "variable",
          "queryText": "get ticks select sym, sum(qty) as volume group sym order volume desc"
        },
        "definition": "get ticks select sym, sum(qty) as volume group sym order volume desc",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": false,
        "hide": 0,
        "current": {
          "text": [
            "S19",
            "S04",
            "S03"
          ],
          "value": [
            "S19",
            "S04",
            "S03"
          ]
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Daily high of $sym",
        "datasource": {
          "type": "fenecdb-datasource",
          "uid": "fenecdb"
        },
        "enable": true,
        "iconColor": "yellow",
        "filter": {
          "exclude": false,
          "ids": [
            7
          ]
        },
        "target": {
          "refId": "Anno",
          "format": "table",
          "params": [],
          "queryText": "get ticks select last(at by px) as time, max(px) as text, bucket(at, 1d) as day where sym = $sym and at >= $__from and at < $__to group day order day"
        }
      }
    ]
  },
  "links": [
    {
      "title": "fenecdb data (Infinity)",
      "type": "link",
      "url": "/d/fenecdb-data",
      "icon": "dashboard"
    },
    {
      "title": "fenecdb metrics",
      "type": "link",
      "url": "/d/fenecdb",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Analytics: events",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "datasource": {
        "type": "fenecdb-datasource",
        "uid": "fenecdb"
      },
      "type": "stat",
      "title": "Events, visitors and signups",
      "description": "One statement over the time range: count(*), count(distinct user) and the signups finished.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "fenecdb-datasource",
            "uid": "fenecdb"
          },
          "queryText": "get events select count(*) as Events, count(distinct user) as Visitors, sum(case when name = \"signup_completed\" then 1 else 0 end) as Signups where at >= $__from and at < $__to",
          "params": [],
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      }
    },
    {
      "id": 3,
      "datasource": {
        "type": "fenecdb-datasource",
        "uid": "fenecdb"
      },
      "type": "timeseries",
      "title": "Visitors over time",
      "description": "Events and distinct visitors a bucket: bucket(at, $__interval_ms), the range and the interval passed as parameters.",
      "gridPos": {
        "h": 9,
        "w": 15,
        "x": 0,
        "y": 5
      },
      "interval": "1m",
      "maxDataPoints": 300,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "fenecdb-datasource",
            "uid": "fenecdb"
          },
          "queryText": "get events select bucket(at, $__interval_ms) as Time, count(*) as Events, count(distinct user) as Visitors where at >= $__from and at < $__to group Time order Time",
          "params": [],
          "format": "auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "datasource": {
        "type": "fenecdb-datasource",
        "uid": "fenecdb"
      },
      "type": "table",
      "title": "Top pages",
      "description": "Pageviews and distinct visitors a path over the range, the ten most viewed.",
      "gridPos": {
        "h": 9,
        "w": 9,
        "x": 15,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "fenecdb-datasource",
            "uid": "fenecdb"
          },
          "queryText": "get events select path as Page, count(*) as Views, count(distinct user) as Visitors where name = \"pageview\" and at >= $__from and at < $__to group Page order Views desc limit 10",
          "params": [],
          "format": "auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "minWidth": 50,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Views"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Visitors"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 5,
      "datasource": {
        "type": "fenecdb-datasource",
        "uid": "fenecdb"
      },
      "type": "barchart",
      "title": "Distinct users per day (UTC)",
      "description": "count(distinct user) by bucket(at, 1d): exact, up to a million values a query. approx_count_distinct(user) is the HyperLogLog estimate past that.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "fenecdb-datasource",
            "uid": "fenecdb"
          },
          "queryText": "get events select bucket(at, 1d) as Day, count(distinct user) as Users where at >= $__from and at < $__to group Day order Day",
          "params": [],
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "Day",
        "orientation": "vertical",
        "showValue": "always",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "stacking": "none",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "type": "row",
      "id": 6,
      "title": "Market data: ticks",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 7,
      "datasource": {
        "type": "fenecdb-datasource",
        "uid": "fenecdb"
      },
      "type": "candlestick",
      "title": "Candles: $sym",
      "description": "Open, high, low, close and volume a bucket: first(px by at), max(px), min(px), last(px by at), sum(qty). The symbol is a parameter too, quoted by Grafana's doublequote format (its own quotes, none around it).",
      "gridPos": {
        "h": 11,
        "w": 15,
        "x": 0,
        "y": 23
      },
      "interval": "1m",
      "maxDataPoints": 120,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "fenecdb-datasource",
            "uid": "fenecdb"
          },
          "queryText": "get ticks select bucket(at, $__interval_ms) as Time, first(px by at) as open, max(px) as high, min(px) as low, last(px by at) as close, sum(qty) as volume where sym = $sym and at >= $__from and at < $__to group Time order Time",
          "params": [],
          "format": "auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "volume"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "mode": "candles+volume",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "colors": {
          "up": "green",
          "down": "red"
        },
        "includeAllFields": false,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      }
    },
    {
      "id": 8,
      "datasource": {
        "type": "fenecdb-datasource",
        "uid": "fenecdb"
      },
      "type": "table",
      "title": "Latest price per symbol",
      "description": "Each symbol's last trade before the range's end, last(px by at), and its change since the first trade in the range.",
      "gridPos": {
        "h": 11,
        "w": 9,
        "x": 15,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "fenecdb-datasource",
            "uid": "fenecdb"
          },
          "queryText": "get ticks select sym as Symbol, last(px by at) as Price, (last(px by at) - first(px by at)) / first(px by at) * 100 as Change, sum(qty) as Volume where at >= $__from and at < $__to group Symbol order Symbol",
          "params": [],
          "format": "auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 50,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Price"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Change"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 0
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Volume"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Volume by symbol: $syms",
      "description": "A group by time and symbol, made a series a symbol by the plugin (long to wide); the symbols a multi-value variable, bound as `in [$1, $2, ...]`.",
      "datasource": {
        "type": "fenecdb-datasource",
        "uid": "fenecdb"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "fenecdb-datasource",
            "uid": "fenecdb"
          },
          "format": "time_series",
          "params": [],
          "queryText": "get ticks select bucket(at, $__interval_ms) as Time, sym, sum(qty) as volume where sym in $syms and at >= $__from and at < $__to group Time, sym order Time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
