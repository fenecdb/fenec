      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "The change sequence's rate: every write, over any transport, and a replica's applied ones.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "fieldConfig": {
