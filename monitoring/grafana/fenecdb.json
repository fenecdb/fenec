      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "fenec_dead_bytes{instance=~\"$instance\"} / (fenec_data_bytes{instance=~\"$instance\"} + fenec_dead_bytes{instance=~\"$instance\"})",
          "legendFormat": "{{collection}}",
          "refId": "A"
        }
      ]
    },
