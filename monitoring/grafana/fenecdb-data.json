            "type": "yesoreyeram-infinity-datasource",
            "uid": "fenecdb-data"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\n  \"query\": \"get events select path, count(*) as views, count(distinct user) as visitors where name = \\\"pageview\\\" and at >= $1 and at < $2 group path order views desc limit 10\",\n  \"params\": [${__from}, ${__to}]\n}"
          },
          "root_selector": "",
          "columns": [
