    {
      "id": 2,
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "fenecdb-data"
      },
      "type": "stat",
      "title": "Events, visitors and signups",
      "description": "One statement over the time range: count(*), count(distinct user) and the signups finished.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "fenecdb-data"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\n  \"query\": \"get events select count(*) as events, count(distinct user) as visitors, sum(case when name = \\\"signup_completed\\\" then 1 else 0 end) as signups where at >= $1 and at < $2\",\n  \"params\": [${__from}, ${__to}]\n}"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "events",
              "text": "Events",
              "type": "number"
            },
            {
              "selector": "visitors",
              "text": "Visitors",
              "type": "number"
            },
            {
              "selector": "signups",
              "text": "Signups",
              "type": "number"
            }
          ],
          "computed_columns": [],
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Events": 0,
              "Visitors": 1,
              "Signups": 2
            },
            "excludeByName": {},
            "renameByName": {}
          }
        }
      ]
    },
