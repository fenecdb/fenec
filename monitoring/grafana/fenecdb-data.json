      },
      "type": "candlestick",
      "title": "Candles: $sym",
      "description": "Open, high, low, close and volume a bucket: first(px by at), max(px), min(px), last(px by at), sum(qty). The symbol is a parameter too, quoted by Grafana's doublequote format (its own quotes, none around it).",
      "gridPos": {
        "h": 11,
        "w": 15,
        "x": 0,
        "y": 23
      },
      "interval": "1m",
      "maxDataPoints": 120,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "fenecdb-data"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\n  \"query\": \"get ticks select bucket(at, $4) as t, first(px by at) as open, max(px) as high, min(px) as low, last(px by at) as close, sum(qty) as volume where sym = $3 and at >= $1 and at < $2 group t order t\",\n  \"params\": [${__from}, ${__to}, ${sym:doublequote}, $__interval_ms]\n}"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "t",
