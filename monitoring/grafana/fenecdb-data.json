    {
      "id": 4,
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "fenecdb-data"
      },
      "type": "table",
      "title": "Top pages",
      "description": "Pageviews and distinct visitors a path over the range, the ten most viewed.",
      "gridPos": {
        "h": 9,
        "w": 9,
        "x": 15,
        "y": 5
