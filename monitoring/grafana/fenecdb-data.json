              "text": "high",
              "type": "number"
            },
            {
              "selector": "low",
              "text": "low",
              "type": "number"
            },
            {
              "selector": "close",
              "text": "close",
              "type": "number"
            },
            {
              "selector": "volume",
              "text": "volume",
              "type": "number"
            }
          ],
          "computed_columns": [],
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "volume"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
