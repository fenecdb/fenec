                      "query": "sum:fenecdb.dead_bytes{$host} by {collection}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "sum:fenecdb.data_bytes{$host} by {collection}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 / (q1 + q2)"
                    }
                  ],
                  "display_type": "line"
