    {
      "definition": {
        "title": "Logs",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Slow statements",
              "type": "list_stream",
              "requests": [
                {
                  "response_format": "event_list",
                  "query": {
                    "data_source": "logs_stream",
                    "query_string": "source:fenecdb @event:slow",
                    "indexes": [],
                    "storage": "hot"
                  },
                  "columns": [
                    {
                      "field": "status_line",
                      "width": "auto"
                    },
                    {
                      "field": "timestamp",
                      "width": "auto"
                    },
                    {
                      "field": "@duration_ms",
                      "width": "auto"
                    },
                    {
                      "field": "@kind",
                      "width": "auto"
                    },
                    {
                      "field": "@tenant",
                      "width": "auto"
                    },
                    {
                      "field": "@request_id",
                      "width": "auto"
                    },
                    {
                      "field": "@statement",
                      "width": "auto"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
