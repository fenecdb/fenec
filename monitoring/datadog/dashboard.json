              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "p50:fenecdb.statement_duration_seconds.bucket{$host} by {kind}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "p95:fenecdb.statement_duration_seconds.bucket{$host} by {kind}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q3",
                      "query": "p99:fenecdb.statement_duration_seconds.bucket{$host} by {kind}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    },
                    {
                      "formula": "q2"
                    },
                    {
                      "formula": "q3"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Mean latency, by kind (seconds)",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:fenecdb.statement_duration_seconds.sum{$host} by {kind}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "sum:fenecdb.statement_duration_seconds.count{$host} by {kind}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 / q2"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Slow statements (--slow-ms)",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:fenecdb.slow_statements.count{$host}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Refused for their token (401)",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
