{
  "title": "fenecdb",
  "description": "fenec-server and fenec-shard through the Agent's OpenMetrics check (monitoring/datadog/conf.yaml) and the logs pipeline (pipeline.json). Every metric here is held to a real /_metrics scrape by crates/fenec-shard/tests/datadog.rs.",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "host",
      "prefix": "host",
      "available_values": [],
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "title": "Overview",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Storage failed (1: writes stopped)",
              "type": "query_value",
              "precision": 0,
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "max:fenecdb.storage_failed{$host}",
                      "aggregator": "max"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ]
                }
              ],
              "conditional_formats": [
                {
                  "comparator": ">=",
                  "value": 1,
                  "palette": "white_on_red"
                },
                {
                  "comparator": "<",
                  "value": 1,
                  "palette": "white_on_green"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Statements a second",
              "type": "query_value",
              "precision": 1,
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:fenecdb.statements.count{$host}.as_rate()",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Errors a second",
              "type": "query_value",
              "precision": 2,
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:fenecdb.statement_errors.count{$host}.as_rate()",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Refused a second",
              "type": "query_value",
              "precision": 2,
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:fenecdb.refused.count{$host}.as_rate()",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Memory footprint",
              "type": "query_value",
              "precision": 0,
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:fenecdb.memory_bytes{$host}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ]
                }
              ],
              "custom_unit": "B"
            }
          },
          {
            "definition": {
              "title": "Versions running",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:fenecdb.build_info{$host} by {version}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Requests",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Statements a second, by kind",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
