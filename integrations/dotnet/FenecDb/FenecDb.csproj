<Project Sdk="Microsoft.NET.Sdk">
  <!-- FenecDb on NuGet: a client for fenec-server's HTTP endpoint, HttpClient
       and System.Text.Json alone. `make version` sets its version. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>FenecDb</RootNamespace>

    <PackageId>FenecDb</PackageId>
    <Version>0.1.6</Version>
    <Authors>fenecdb</Authors>
    <Description>A client for fenecdb's server over HTTP: FenecQL queries, vector search, atomic batches, subscriptions and the change stream.</Description>
    <PackageTags>fenecdb;database;vector;search;hnsw</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://fenecdb.com/docs/languages</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fenecdb/fenec</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="FenecDb.Tests" />
  </ItemGroup>
</Project>
