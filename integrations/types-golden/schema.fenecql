-- The schema every `fenec types` generator is held to: each file beside this
-- one is what `fenec types` writes for it in one language or form, and the
-- CLI's tests make each again (FENEC_TYPES_GOLDEN=write cargo test -p
-- fenec-cli types writes them). Every type, a required field and not, a
-- collation, every index and a path index, a name past ASCII, and a
-- collection named as a builder is.
create collection articles (
  title text required collate tr @text(prefix=6, chars),
  year int @hash,
  score float @sorted,
  draft bool required,
  published timestamp @ttl(30d),
  cover bytes,
  meta json,
  loc geo @geo,
  embed vector<384> @hnsw(cosine, m=8),
  small vector<4, f16> @hnsw(l2, quant=int8),
  splade sparse<30522> @inverted,
  tags [text] @hash,
  counts [int] required,
  slug text @unique
)
create index on articles (meta.lang) @hash
create index on articles (meta.source.rank) @sorted
create collection product_reviews (product_id int required @hash, stars int, notes text collate und)
create collection kişiler (ad text, yaş int)
create collection text (body text)
