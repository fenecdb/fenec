<Project Sdk="Microsoft.NET.Sdk">
  <!-- Npgsql and pgvector's .NET library against a real fenec-server: what they
       send on their own (the type lookup Npgsql opens every connection
       with, typed parameters, binary rows, a transaction) and vectors as
       pgvector-dotnet's Vector both ways. Run by ../run-tests.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
  </ItemGroup>
</Project>
