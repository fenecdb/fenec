{
  // The website and documentation, served as a Cloudflare Worker.
  //
  //   make site            build into site/dist
  //   make site-deploy     build, then wrangler deploy
  //
  // Every request but /api/* is answered from site/dist by the static-asset
  // router, without running the Worker; caching and security headers come
  // from site/dist/_headers, which site/build.py writes on every build.
  // /api/embed is site/worker.js: a search query's embedding, for the
  // search by meaning the page runs (site/README.md, "Search").
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "fenecdb-site",
  "compatibility_date": "2026-09-01",
  "main": "./site/worker.js",

  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Default. `/docs/` serves docs/index.html; `/docs/fenecql.html` serves
    // itself. Both spellings appear in the generated links.
    "html_handling": "auto-trailing-slash",
    // Anything unmatched gets 404.html rather than a bare Cloudflare error.
    "not_found_handling": "404-page"
  },

  // No `routes` here, deliberately — the same call apps/site makes in the
  // backlex repo. A deploy token with Workers Scripts permissions but without
  // Zone > Workers Routes uploads the worker and assets fine and then fails
  // reconciling the route (Authentication error 10000). The routes are stable,
  // so they stay dashboard-managed and CI deploys cleanly.
  //
  //   fenecdb.com          needs a proxied A/AAAA record; a *.fenecdb.com
  //                        wildcard does NOT cover the apex
  //   www.fenecdb.com      redirect or second route, as you prefer
  //
  // To declare them here instead, grant the token Zone > Workers Routes > Edit
  // on the fenecdb.com zone.

  // The embedding endpoint. Off until the AI Gateway below exists: it
  // answers 404 and the search stays with the words. The owner's steps to
  // turn it on are in site/README.md ("Search by meaning").
  "vars": {
    "SEMANTIC": "off",
    // The gateway every embedding goes through, for its cache, its rate
    // limit and its logs.
    "AI_GATEWAY": "fenecdb-site",
    // The day's cap, in Workers AI neurons: half the 10 000 a day an
    // account has free. Past it the endpoint answers 429 until midnight UTC.
    "DAILY_NEURONS": "5000"
  },
  "ai": { "binding": "AI" },
  // Per address, on top of the gateway's limit over every address.
  "ratelimits": [
    { "name": "PER_IP", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "Budget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Budget"] }],

  "observability": { "enabled": true }
}
