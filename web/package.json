{
  "name": "@fenecdb/web",
  "version": "0.1.8",
  "description": "fenecdb in the browser: the engine as WebAssembly, and dependency-free ES modules with its query builder, HTTP client and sync layer -- or the client alone, with no engine (@fenecdb/web/client)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "fenec.js",
  "types": "fenec.d.ts",
  "exports": {
    ".": {
      "types": "./fenec.d.ts",
      "default": "./fenec.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./schema": {
      "types": "./schema.d.ts",
      "default": "./schema.js"
    },
    "./fenec.wasm": "./fenec.wasm",
    "./fenec-lite.wasm": "./fenec-lite.wasm",
    "./fenec-replica.wasm": "./fenec-replica.wasm",
    "./collate/*": "./collate/*",
    "./package.json": "./package.json"
  },
  "files": [
    "fenec.js",
    "fenec.d.ts",
    "builder.js",
    "http.js",
    "client.js",
    "client.d.ts",
    "schema.js",
    "schema.d.ts",
    "fenec.wasm",
    "fenec-lite.wasm",
    "fenec-replica.wasm",
    "collate/"
  ],
  "sideEffects": false,
  "keywords": [
    "database",
    "vector",
    "embedded",
    "wasm",
    "hnsw",
    "bm25",
    "local-first",
    "sync"
  ],
  "homepage": "https://fenecdb.com/docs/javascript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fenecdb/fenec.git",
    "directory": "web"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
