<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Include="schema.fenecql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The published package; `-p:FenecLocal=<repository root>` builds against
       this repository's SDK instead, as CI does. -->
  <ItemGroup Condition="'$(FenecLocal)' == ''">
    <PackageReference Include="FenecDb" Version="0.1.9" />
  </ItemGroup>
  <ItemGroup Condition="'$(FenecLocal)' != ''">
    <ProjectReference Include="$(FenecLocal)/integrations/dotnet/FenecDb/FenecDb.csproj" />
  </ItemGroup>
</Project>
